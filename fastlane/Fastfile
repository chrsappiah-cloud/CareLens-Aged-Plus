# CareLens Aged+ — TestFlight & App Store distribution
# Docs: https://docs.fastlane.tools

default_platform(:ios)

APP_IDENTIFIER = "wcs.Carelens-Aged-"
SCHEME = "Carelens-Aged+"
XCODEPROJ = "Carelens-Aged+.xcodeproj"
ASC_APP_ID = "6767072418"
IPA_PATH = File.expand_path("../build/CarelensAged.ipa", __dir__)

def asc_api_key
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"] || ENV["ASC_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"] || ENV["ASC_ISSUER_ID"]
  return nil unless key_id && issuer_id

  key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"] ||
    File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")

  if File.exist?(key_path)
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )
  elsif ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: ENV.fetch("APP_STORE_CONNECT_API_KEY_IS_BASE64", "true") == "true",
      in_house: false
    )
  end
end

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Run unit tests"
  lane :test do
    run_tests(
      project: XCODEPROJ,
      scheme: SCHEME,
      device: "iPhone 17 Pro Max",
      code_coverage: true
    )
  end

  desc "Generate App Store screenshots (iPhone + iPad)"
  lane :screenshots do
    sh("../scripts/generate_screenshots.sh")
    prepare_screenshot_folders
  end

  desc "Copy generated screenshots into deliver folders (iphone65 + ipadPro129)"
  lane :prepare_screenshot_folders do
    iphone_src = "../AppStoreAssets/screenshots/iphone_6.9"
    ipad_src = "../AppStoreAssets/screenshots/ipad_12.9"
    iphone_dest = "./screenshots/en-US"
    ipad_dest = "./screenshots/en-US/iPad Pro (12.9-inch) (3rd generation)"

    sh("mkdir -p '#{iphone_dest}' '#{ipad_dest}'")
    sh("rm -f '#{iphone_dest}'/*.png '#{ipad_dest}'/*.png")

    sh(<<~SCRIPT)
      for src in "#{iphone_src}"/*.png; do
        [ -f "$src" ] || continue
        base=$(basename "$src" .png)
        sips -z 2778 1284 "$src" --out "#{iphone_dest}/${base}_iphone65.png" >/dev/null
      done
    SCRIPT

    sh(<<~SCRIPT)
      n=1
      for src in $(ls "#{ipad_src}"/*.png 2>/dev/null | sort); do
        out="#{ipad_dest}/$(printf '%02d' $n)_ipadPro129.png"
        sips -z 2732 2048 "$src" --out "$out" >/dev/null
        cp "$out" "#{iphone_dest}/$(printf '%02d' $n)_ipadPro129.png"
        n=$((n + 1))
      done
    SCRIPT
  end

  desc "Increment build number from latest TestFlight build"
  lane :bump_build do
    api_key = asc_api_key
    if api_key
      latest = latest_testflight_build_number(
        app_identifier: APP_IDENTIFIER,
        api_key: api_key
      )
      increment_build_number(
        build_number: (latest + 1).to_s,
        xcodeproj: XCODEPROJ
      )
    else
      increment_build_number(xcodeproj: XCODEPROJ)
    end
    UI.success("Build number: #{get_build_number(xcodeproj: XCODEPROJ)}")
  end

  desc "Build Release IPA"
  lane :build_release do
    # Xcode export uses rsync flags that break with Homebrew/MacPorts rsync on PATH.
    ENV["PATH"] = "/usr/bin:/bin:/usr/sbin:/sbin:/Applications/Xcode.app/Contents/Developer/usr/bin:#{ENV['PATH']}"

    bump_build if ENV.fetch("BUMP_BUILD", "true") == "true"

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: "./fastlane/ExportOptions.plist",
      output_directory: "../build",
      output_name: "CarelensAged",
      clean: true,
      export_team_id: "TM2WG7HH96",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=TM2WG7HH96"
    )
  end

  desc "Upload build to TestFlight"
  lane :beta do
    build_release

    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      apple_id: ASC_APP_ID,
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", default_changelog),
      distribute_external: false
    )
  end

  desc "Upload App Privacy nutrition labels to App Store Connect"
  lane :privacy do
    upload_app_privacy_details_to_app_store(
      app_identifier: APP_IDENTIFIER,
      team_id: ENV.fetch("APP_STORE_CONNECT_TEAM_ID", "TM2WG7HH96"),
      json_path: "./fastlane/app_privacy_details.json"
    )
  end

  desc "Remove China mainland from App Store availability"
  lane :exclude_china do
    sh("ruby ../scripts/exclude_china_availability.rb")
  rescue StandardError => e
    UI.important("Could not update China availability via API: #{e.message}")
    UI.important("Remove China (CHN) manually in App Store Connect → access settings and Availability before review.")
  end

  desc "Upload build 4 IPA, metadata, and submit for App Review (skip screenshot re-upload)"
  lane :submit_review do
    exclude_china

    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: IPA_PATH,
      app_version: get_version_number(xcodeproj: XCODEPROJ),
      primary_category: "MEDICAL",
      app_rating_config_path: "./fastlane/metadata/age_rating.json",
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Build, upload screenshots/metadata, exclude China, and submit for App Review"
  lane :resubmit_review do
    if ENV.fetch("SKIP_SCREENSHOT_REGEN", "false") == "true"
      prepare_screenshot_folders
    else
      screenshots
    end
    exclude_china
    build_release unless ENV.fetch("SKIP_BUILD", "false") == "true"

    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: IPA_PATH,
      app_version: get_version_number(xcodeproj: XCODEPROJ),
      primary_category: "MEDICAL",
      app_rating_config_path: "./fastlane/metadata/age_rating.json",
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Upload metadata + screenshots and submit for App Review"
  lane :release do
    prepare_screenshot_folders if Dir["./screenshots/en-US/*.png"].empty?

    privacy rescue UI.important("Privacy labels upload skipped or already set")

    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: get_version_number(xcodeproj: XCODEPROJ),
      build_number: get_build_number(xcodeproj: XCODEPROJ),
      primary_category: "MEDICAL",
      app_rating_config_path: "./fastlane/metadata/age_rating.json",
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Upload metadata and screenshots only (no review submission)"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: get_version_number(xcodeproj: XCODEPROJ),
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true
    )
  end
end

def default_changelog
  <<~NOTES
    CareLens Aged+ 1.0 (build 5)
    • No locked digital content or user-facing access screens
    • Access tiers assigned by organisation administrators only
    • WCS testing kit suites and physical-device E2E verification
    • Fixed iPad launch crash (SwiftData ModelContainer)
    • Excluded China mainland App Store availability
  NOTES
end
