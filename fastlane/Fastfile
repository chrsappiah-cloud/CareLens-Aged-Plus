# CareLens Aged+ — TestFlight & App Store distribution
# Docs: https://docs.fastlane.tools

default_platform(:ios)

APP_IDENTIFIER = "wcs.Carelens-Aged-"
SCHEME = "Carelens-Aged+"
XCODEPROJ = "Carelens-Aged+.xcodeproj"
ASC_APP_ID = "6767072418"

def asc_api_key
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"] || ENV["ASC_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"] || ENV["ASC_ISSUER_ID"]
  return nil unless key_id && issuer_id

  key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"] ||
    File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")

  if File.exist?(key_path)
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )
  elsif ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: ENV.fetch("APP_STORE_CONNECT_API_KEY_IS_BASE64", "true") == "true",
      in_house: false
    )
  end
end

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Run unit tests"
  lane :test do
    run_tests(
      project: XCODEPROJ,
      scheme: SCHEME,
      device: "iPhone 17 Pro Max",
      code_coverage: true
    )
  end

  desc "Generate App Store screenshots (iPhone + iPad)"
  lane :screenshots do
    sh("../scripts/generate_screenshots.sh")
    sh("cp -R ../AppStoreAssets/screenshots/iphone_6.9/. ./screenshots/en-US/")
    sh("mkdir -p ./screenshots/en-US/iPad\\ Pro\\ \\(12.9-inch\\)\\ \\(6th\\ generation\\)/")
    sh("cp -R ../AppStoreAssets/screenshots/ipad_13/. ./screenshots/en-US/iPad\\ Pro\\ \\(12.9-inch\\)\\ \\(6th\\ generation\\)/")
  end

  desc "Increment build number from latest TestFlight build"
  lane :bump_build do
    api_key = asc_api_key
    if api_key
      latest = latest_testflight_build_number(
        app_identifier: APP_IDENTIFIER,
        api_key: api_key
      )
      increment_build_number(
        build_number: (latest + 1).to_s,
        xcodeproj: XCODEPROJ
      )
    else
      increment_build_number(xcodeproj: XCODEPROJ)
    end
    UI.success("Build number: #{get_build_number(xcodeproj: XCODEPROJ)}")
  end

  desc "Build Release IPA"
  lane :build_release do
    bump_build if ENV.fetch("BUMP_BUILD", "true") == "true"

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: "./fastlane/ExportOptions.plist",
      output_directory: "./build",
      output_name: "CarelensAged",
      clean: true,
      export_team_id: "TM2WG7HH96",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=TM2WG7HH96"
    )
  end

  desc "Upload build to TestFlight"
  lane :beta do
    build_release

    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      apple_id: ASC_APP_ID,
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", default_changelog),
      distribute_external: false
    )
  end

  desc "Upload metadata + screenshots and submit for App Review"
  lane :release do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: get_version_number(xcodeproj: XCODEPROJ),
      build_number: get_build_number(xcodeproj: XCODEPROJ),
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Upload metadata and screenshots only (no review submission)"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: get_version_number(xcodeproj: XCODEPROJ),
      skip_binary_upload: true,
      skip_screenshots: false,
      submit_for_review: false,
      force: true
    )
  end
end

def default_changelog
  <<~NOTES
    CareLens Aged+ 1.0
    • AI-assisted clinical decision support for aged care teams
    • NeuroWatch cognitive monitoring and biopsychosocial assessments
    • Care plans, reports, and CloudKit sync
    • Subscription tiers via Apple In-App Purchase
  NOTES
end
